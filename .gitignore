# ---------------------------------------------------------------------------
# Secrets and local platform state — never commit any of these.
# ---------------------------------------------------------------------------
# Local env files (Supabase keys etc.)
.env
.env.*
!.env.example

# Key material and credential stores. No file in this project uses these
# extensions today; the rules exist so a future one cannot be added by `git add .`
*.pem
*.key
*.p12
*.pfx
*.jwks
id_rsa
id_rsa.*
service-account*.json
.netrc
_netrc

# Supabase CLI local state. `supabase/volumes/` is the running local database's
# data directory — it would hold real rows the moment anyone signs up locally.
supabase/.temp/
supabase/.branches/
supabase/volumes/
supabase/.local/

# Local uploads and private data directories
public/uploads/
uploads/
private/
*.sqlite
*.sqlite3
*.db

# Design-review screenshots — local QA artefacts, referenced by no source or
# document. Kept on disk, not published.
design-review/
